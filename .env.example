# Copy to .env for local development. Never commit real values.
APP_NAME=baggage-finder-api
APP_VERSION=1.0.0
DESCRIPTION=Baggage Finder FastAPI Service
ENVIRONMENT=development
DEBUG=true

# Public path the API is served under (the mobile app's base URL ends in /api/).
API_PREFIX=/api

# Local Postgres from docker-compose (host port 5432). SQLite also works for quick local runs:
#   sqlite+aiosqlite:///./baggage_finder_db.db
# DATABASE_URL=sqlite+aiosqlite:///./baggage_finder_db.db

# Database configuration
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_sTI2ADboiPH4@ep-shy-cake-b5uqboey-pooler.c-7.us-east-2.aws.neon.tech/neondb
DATABASE_SSL=true
DATABASE_ECHO=false

# Connection pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# Per-IP, per-process limit for signUp / login / password-reset endpoints.
RATE_LIMIT_PER_MINUTE=10

# Browser origins only (mobile apps don't use CORS). JSON array or comma-separated; empty disables CORS.
ALLOWED_ORIGINS=[]

FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
# Or paste the whole JSON (Azure App Settings / Key Vault) instead of a file:
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID = baggage-finder
FIREBASE_WEB_API_KEY = AIzaSyBmcwmZ1RTMzqwxYoKUdHhBg_u4nxvyv5M  # public web key: Project settings > General
FIREBASE_AUTH_DOMAIN = None  # defaults to <project id>.firebaseapp.com
FIREBASE_WEB_SDK_VERSION = "10.14.1"  # loaded by the QR page from gstatic.com
PUSH_CHAT_DATA_ONLY = true

QR_SCAN_PUSH_COOLDOWN_SECONDS=600
QR_FOUND_COOLDOWN_SECONDS=60
QR_REVEAL_PHONE_WHEN_LOST=false

LOG_LEVEL=INFO
LOG_FORMAT=text
